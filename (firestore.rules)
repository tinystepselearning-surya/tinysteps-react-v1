rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // CONTACT INFORMATION
    // ============================================
    // Parent queries: info@tinystepslearning.com
    // Partnerships: priya@tinystepslearning.com
    // General messages: contact@tinystepslearning.com
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isRM() {
      return isAuthenticated() && getUserRole() == 'learning-partner';
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }
    
    function isParent() {
      return isAuthenticated() && getUserRole() == 'parent';
    }
    
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }
    
    function isAdminOrRM() {
      return isAdmin() || isRM();
    }
    
    function isStaff() {
      return isAdmin() || isRM() || isTeacher();
    }

    // Validate a course document shape for writes
    function isCourse(data) {
      return data.keys().hasOnly(['title','category','level','sortOrder','active']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.category in ['phonics','grammar_writing','public_speaking'] &&
             data.sortOrder is number &&
             data.active is bool &&
             // level may be absent, null, or string
             (!('level' in data) || data.level == null || data.level is string);
    }

    // ---------- AI helpers: student relationships ----------
    // Fetch a student document (for teacher/RM checks)
    function studentDoc(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data;
    }

    // True if the current user is the assigned teacher for this student
    function isTeacherOfStudent(studentId) {
      return isTeacher() &&
             studentDoc(studentId).assignedTeacherId == request.auth.uid;
    }

    // True if the current user is the assigned RM for this student
    function isRmOfStudent(studentId) {
      return isRM() &&
             studentDoc(studentId).assignedRmId == request.auth.uid;
    }

    // True if the current user is a parent of this student
    function isParentOfStudent(studentId) {
      return isParent() &&
             exists(/databases/$(database)/documents/parents/$(request.auth.uid)/children/$(studentId));
    }

    // True if the current user is the student themself
    // (Your design assumes studentId == student's auth uid)
    function isStudentSelf(studentId) {
      return isStudent() && request.auth.uid == studentId;
    }
    
    // Check if user owns this resource
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    // Check if resource has required audit fields
    function hasValidAudit() {
      return request.resource.data.keys().hasAll(['updatedBy', 'updatedAt']) &&
             request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.updatedAt == request.time;
    }
    
    // Check if creating with required fields
    function hasValidCreate() {
      return request.resource.data.keys().hasAll(['createdBy', 'createdAt', 'updatedBy', 'updatedAt']) &&
             request.resource.data.createdBy == request.auth.uid &&
             request.resource.data.updatedBy == request.auth.uid;
    }
    
    // ============================================
    // /users/{uid}
    // ============================================
    match /users/{uid} {
      // Anyone can read their own user doc
      allow read: if isOwner(uid) || isStaff();
      
      // Only admin can create/update/delete users
      allow create: if isAdmin() && hasValidCreate();
      allow update: if isAdmin() && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /usernames/{username}
    // ============================================
    match /usernames/{username} {
      // Anyone can check if username exists (for uniqueness)
      allow read: if isAuthenticated();
      
      // Only admin can create username mappings
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /parents/{parentId}
    // ============================================
    match /parents/{parentId} {
      allow read: if isOwner(parentId) || isStaff();
      allow create: if isAdmin() && hasValidCreate();
      allow update: if isAdmin() && hasValidAudit();
      allow delete: if isAdmin();
      
      // /parents/{parentId}/children/{childId}
      match /children/{childId} {
        allow read: if isOwner(parentId) || isStaff();
        allow write: if isAdmin();
      }
    }
    
    // ============================================
    // /students/{studentId}
    // ============================================
    match /students/{studentId} {
      function isStudentParent() {
        return isParent() && 
               exists(/databases/$(database)/documents/parents/$(request.auth.uid)/children/$(studentId));
      }

      function isAssignedTeacher() {
        return isTeacher() && 
               get(/databases/$(database)/documents/students/$(studentId)).data.assignedTeacherId == request.auth.uid;
      }

      function isAssignedRM() {
        return isRM() && 
               get(/databases/$(database)/documents/students/$(studentId)).data.assignedRmId == request.auth.uid;
      }

      // Parents can read their children, teachers their students, RMs their cohort
      allow read: if isOwner(studentId) || isStudentParent() || isAssignedTeacher() || isAssignedRM() || isAdmin();

      // Only admin/RM can create/update student records
      allow create: if isAdminOrRM() && hasValidCreate();
      allow update: if isAdminOrRM() && hasValidAudit();
      allow delete: if isAdmin();

      // /students/{studentId}/attendance/{date}
      match /attendance/{date} {
        allow read: if isOwner(studentId) || isStudentParent() || isAssignedTeacher() || isAssignedRM() || isAdmin();
        allow create, update: if isStaff() && hasValidAudit();
        allow delete: if isAdmin();
      }

      // /students/{studentId}/curriculum/{topicId}
      match /curriculum/{topicId} {
        allow read: if isOwner(studentId) || isStudentParent() || isAssignedTeacher() || isAssignedRM() || isAdmin();
        allow create, update: if (isAssignedTeacher() || isAdmin()) && hasValidAudit();
        allow delete: if isAdmin();
      }

      // /students/{studentId}/progress/{topicId}
      match /progress/{topicId} {
        allow read: if isOwner(studentId) || isStudentParent() || isAssignedTeacher() || isAssignedRM() || isAdmin();
        allow create, update: if (isAssignedTeacher() || isAdmin()) && hasValidAudit();
        allow delete: if isAdmin();
      }
    }

    // ============================================
    // AI Collections (Practice Buddy, Worksheets, etc.)
    // ============================================

    // 1. AI sessions (one record per AI interaction session)
    match /ai-sessions/{sessionId} {
      // Who can SEE this session?
      allow read: if isAdmin()
        || isTeacherOfStudent(resource.data.studentId)
        || isParentOfStudent(resource.data.studentId)
        || isStudentSelf(resource.data.studentId)
        || isRmOfStudent(resource.data.studentId);

      // Who can CREATE a session?
      // Typically Cloud Functions do this, but allow admin/teacher/RM if needed.
      allow create: if isAdmin()
        || isTeacherOfStudent(request.resource.data.studentId)
        || isRmOfStudent(request.resource.data.studentId);

      // Who can UPDATE a session? (e.g., status: running → completed)
      allow update: if isAdmin()
        || isTeacherOfStudent(resource.data.studentId)
        || isRmOfStudent(resource.data.studentId);

      // Only admin can hard delete sessions
      allow delete: if isAdmin();
    }

    // 2. AI usage logs (tokens & cost per student/use)
    match /ai-usage-logs/{logId} {
      // Usually written by Cloud Functions with Admin SDK
      allow read: if isAdmin()
        || isTeacherOfStudent(resource.data.studentId)
        || isParentOfStudent(resource.data.studentId)
        || isRmOfStudent(resource.data.studentId);

      allow create: if isAdmin()
        || isTeacherOfStudent(request.resource.data.studentId)
        || isParentOfStudent(request.resource.data.studentId)
        || isRmOfStudent(request.resource.data.studentId);

      allow update, delete: if isAdmin();
    }

    // 3. AI error logs (for debugging)
    match /ai-error-logs/{errorId} {
      // Error details only for admin
      allow read: if isAdmin();

      // Creation can be done by admin or by a role associated with that student
      // (but typically Cloud Functions will write with Admin SDK and bypass rules)
      allow create: if isAdmin()
        || isTeacherOfStudent(request.resource.data.studentId)
        || isParentOfStudent(request.resource.data.studentId)
        || isRmOfStudent(request.resource.data.studentId);

      allow update, delete: if isAdmin();
    }

    // 4. Student AI history (actual prompts & responses)
    match /student-ai-history/{historyId} {
      // Who can SEE a student's AI history?
      allow read: if isAdmin()
        || isTeacherOfStudent(resource.data.studentId)
        || isParentOfStudent(resource.data.studentId)
        || isStudentSelf(resource.data.studentId)
        || isRmOfStudent(resource.data.studentId);

      // Who can CREATE history entries?
      // - Admin (batch imports or tools)
      // - Teacher (AI used in class)
      // - Parent (homework assisted with AI)
      // - Student themself
      // - RM (if needed for coaching)
      allow create: if isAdmin()
        || isTeacherOfStudent(request.resource.data.studentId)
        || isParentOfStudent(request.resource.data.studentId)
        || isStudentSelf(request.resource.data.studentId)
        || isRmOfStudent(request.resource.data.studentId);

      // Who can UPDATE an entry? (e.g., add rating, small edits)
      allow update: if isAdmin()
        || isTeacherOfStudent(resource.data.studentId)
        || isParentOfStudent(resource.data.studentId)
        || isStudentSelf(resource.data.studentId)
        || isRmOfStudent(resource.data.studentId);

      // Only admin can delete AI history
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /sessions/{sessionId}
    // ============================================
    match /sessions/{sessionId} {
      function isSessionParticipant() {
        let session = resource.data;
        return isOwner(session.studentId) || 
               isOwner(session.teacherId) || 
               (isRM() && session.rmId == request.auth.uid);
      }
      
      allow read: if isSessionParticipant() || isAdmin();
      allow create: if isStaff() && hasValidCreate();
      allow update: if (isSessionParticipant() || isAdmin()) && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /assignments/{assignmentId}
    // ============================================
    match /assignments/{assignmentId} {
      function isAssignedStudent() {
        return isStudent() && 
               request.auth.uid in resource.data.studentIds;
      }
      
      function isAssigner() {
        return isAuthenticated() && 
               resource.data.assignedBy == request.auth.uid;
      }
      
      allow read: if isAssignedStudent() || isAssigner() || isStaff();
      allow create: if isTeacher() && hasValidCreate();
      allow update: if (isAssigner() || isAdmin()) && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /submissions/{submissionId}
    // ============================================
    match /submissions/{submissionId} {
      function isSubmitter() {
        return isOwner(resource.data.studentId);
      }
      
      function isStudentTeacher() {
        let studentId = resource.data.studentId;
        let student = get(/databases/$(database)/documents/students/$(studentId));
        return isTeacher() && student.data.assignedTeacherId == request.auth.uid;
      }
      
      allow read: if isSubmitter() || isStudentTeacher() || isStaff();
      allow create: if isStudent() && hasValidCreate();
      allow update: if (isStudentTeacher() || isAdmin()) && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /payments/{paymentId}
    // ============================================
    match /payments/{paymentId} {
      function isPaymentOwner() {
        return isParent() && resource.data.parentId == request.auth.uid;
      }
      
      allow read: if isPaymentOwner() || isStaff();
      allow create: if (isParent() || isAdminOrRM()) && hasValidCreate();
      allow update: if isAdminOrRM() && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /plans/{planId}
    // ============================================
    match /plans/{planId} {
      // Anyone can read plans
      allow read: if isAuthenticated();
      
      // Only admin can manage plans
      allow create, update: if isAdmin() && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /courses/{courseId}
    // ============================================
    match /courses/{courseId} {
      // Any signed-in user can read (for dropdowns / library views)
      allow read: if request.auth != null;

      // Only admin can create courses and the document must match the course schema
      allow create: if request.auth != null && request.auth.token.role == 'admin' && isCourse(request.resource.data);

      // Only admin can update and the new data must match the course schema
      allow update: if request.auth != null && request.auth.token.role == 'admin' && isCourse(request.resource.data);

      // Only admin can delete
      allow delete: if request.auth != null && request.auth.token.role == 'admin';

      // /courses/{courseId}/topics/{topicId}
      match /topics/{topicId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.token.role == 'admin';
      }
    }
    
    // ============================================
    // /audit/{eventId}
    // ============================================
    match /audit/{eventId} {
      // Anyone can read their own audit trail
      allow read: if isAuthenticated() && (
        resource.data.actorUid == request.auth.uid || 
        isAdmin()
      );
      
      // System/Cloud Functions can write (via Admin SDK)
      // Regular users cannot write directly
      allow write: if false;
    }
    
    // ============================================
    // /notifications/{notificationId}
    // ============================================
    match /notifications/{notificationId} {
      function isRecipient() {
        return isAuthenticated() && 
               request.auth.uid in resource.data.recipientIds;
      }
      
      allow read: if isRecipient() || isAdmin();
      
      // Staff (including RMs) can create notifications
      allow create: if isStaff() && hasValidCreate();
      
      // Users can mark as read
      allow update: if isRecipient() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'read']);
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /teachers/{teacherId}
    // ============================================
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId) || isStaff();
      allow create, update: if isAdmin() && hasValidAudit();
      allow delete: if isAdmin();
      
      // /teachers/{teacherId}/earnings/{month}
      match /earnings/{month} {
        allow read: if isOwner(teacherId) || isAdminOrRM();
        allow write: if isAdmin();
      }
    }
    
    // ============================================
    // /rms/{rmId}
    // ============================================
    match /rms/{rmId} {
      allow read: if isOwner(rmId) || isAdmin();
      allow create, update: if isAdmin() && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /resources/{resourceId}
    // ============================================
    match /resources/{resourceId} {
      // Teachers and staff can read
      allow read: if isStaff();
      
      // Admin can manage global resources
      allow create, update: if isAdmin() && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /bookmarks/{bookmarkId}
    // ============================================
    match /bookmarks/{bookmarkId} {
      function isBookmarkOwner() {
        return isAuthenticated() && resource.data.userId == request.auth.uid;
      }
      
      // Users can read their own bookmarks
      allow read: if isBookmarkOwner();
      
      // Teachers can create/update/delete their own bookmarks
      allow create: if isTeacher() && hasValidCreate() && 
                       request.resource.data.userId == request.auth.uid;
      allow update: if isBookmarkOwner() && hasValidAudit();
      allow delete: if isBookmarkOwner() || isAdmin();
    }
    
    // ============================================
    // /tickets/{ticketId}
    // ============================================
    match /tickets/{ticketId} {
      function isTicketOwner() {
        return isAuthenticated() && resource.data.createdBy == request.auth.uid;
      }
      
      allow read: if isTicketOwner() || isStaff();
      allow create: if isAuthenticated() && hasValidCreate();
      allow update: if isAdminOrRM() && hasValidAudit();
      allow delete: if isAdmin();
      
      // /tickets/{ticketId}/messages/{messageId}
      match /messages/{messageId} {
        allow read: if isTicketOwner() || isStaff();
        allow create: if (isTicketOwner() || isStaff()) && hasValidCreate();
        allow update, delete: if isAdmin();
      }
    }
    
    // ============================================
    // /consent/{consentId}
    // ============================================
    match /consent/{consentId} {
      function isConsentOwner() {
        return isAuthenticated() && resource.data.userId == request.auth.uid;
      }
      
      allow read: if isConsentOwner() || isAdmin();
      allow create: if isAuthenticated() && hasValidCreate();
      allow update: if isConsentOwner() && hasValidAudit();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // /system_stats/{statsId}
    // ============================================
    match /system_stats/{statsId} {
      // Only admins can read system stats
      allow read: if isAdmin();
      
      // Only Cloud Functions can write stats
      allow write: if false;
    }
    
    // ============================================
    // /audit_logs/{logId}
    // ============================================
    match /audit_logs/{logId} {
      // Admins can read all audit logs
      allow read: if isAdmin();
      
      // Only Cloud Functions can write audit logs
      allow write: if false;
    }
    
    // ============================================
    // /system_settings/{settingId}
    // ============================================
    match /system_settings/{settingId} {
      // Admins can read and update system settings
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Top-level camelCase systemSettings
    // Allow admins to read/write under both naming conventions
    match /systemSettings/{settingId} {
      allow read, write: if isAdmin();
    }
    
    // ============================================
    // /call_logs/{logId}
    // ============================================
    match /call_logs/{logId} {
      // RMs and admins can read all call logs
      allow read: if isAdminOrRM();
      
      // RMs can create call logs
      allow create: if isRM() && hasValidCreate();
      
      // RMs can update their own logs, admins can update any
      allow update: if (isRM() && resource.data.createdBy == request.auth.uid) || isAdmin();
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ---------- 🔹 AUDIT LOGS (Admin only) ----------
    match /{prefix=**}/auditLogs/{logId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // ---------- 🔹 SYSTEM STATS (Admin only) ----------
    match /{prefix=**}/systemStats/{statId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // ---------- 🔹 COURSES (tenant-prefixed) ----------
    // Allow reads for any signed-in user for dropdowns/catalogs; writes only by admin
    match /{prefix=**}/courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ---------- 🔹 COURSE STATS (Admin only) ----------
    match /{prefix=**}/courseStats/{statId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // ---------- 🔹 LESSONS (Admin-only read for analytics) ----------
    // Admin users need read access to lessons so admin-only course analytics
    // (computed client-side) can iterate lessons and build stats.
    match /lessons/{lessonId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // ---------- 🔹 SYSTEM SETTINGS (Admin only) ----------
    match /{prefix=**}/systemSettings/{settingId} {
      allow read, write: if request.auth != null && isAdmin();
    }
    // Tenant-prefixed snake_case variant
    match /{prefix=**}/system_settings/{settingId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // ---------- 🔹 ADMIN CONFIGS (Admin only) ----------
    match /{prefix=**}/adminConfigs/{configId} {
      allow read, write: if request.auth != null && isAdmin();
    }
    
    // ============================================
    // DEFAULT DENY
    // ============================================
    // Any path not explicitly matched above is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
