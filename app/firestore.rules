rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 🔹 Helpers ----------
    function userRole() {
      return request.auth.token.role;
    }

    function isRole(roles) {
      return userRole() in roles;
    }

    // Validate a course document shape for writes
    function isCourse(data) {
      return data.keys().hasOnly(['title','category','level','sortOrder','active']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.category in ['phonics','grammar_writing','public_speaking'] &&
             data.sortOrder is number &&
             data.active is bool &&
             (!('level' in data) || data.level == null || data.level is string);
    }

    // ---------- 🔹 USERS ----------
    match /users/{uid} {
      // Admins can manage all users
      allow read, create, update, delete: if request.auth != null && isRole(['admin']);
      // Individual user can read their own profile
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- 🔹 STUDENTS ----------
    match /students/{sid} {
      allow read: if request.auth != null &&
        (isRole(['admin','rm','teacher']) ||
         resource.data.parentIds.hasAny([request.auth.uid]));
      
      allow write, update, create: if request.auth != null && isRole(['admin','rm','teacher']);
      allow delete: if request.auth != null && isRole(['admin']);
      
      match /attendance/{id} {
        // Allow staff to read all attendance, and allow a parent to read attendance for their own child.
        allow read: if request.auth != null && (
          isRole(['admin','rm','teacher']) ||
          // parentIds are stored on the student document — guard against missing field
          (get(/databases/$(database)/documents/students/$(sid)).exists &&
            get(/databases/$(database)/documents/students/$(sid)).data.parentIds != null &&
            get(/databases/$(database)/documents/students/$(sid)).data.parentIds.hasAny([request.auth.uid]))
          ||
          // Or allow if there's an explicit child link under parents/{uid}/children/{sid}
          (get(/databases/$(database)/documents/parents/$(request.auth.uid)/children/$(sid)).exists)
        );
        allow write: if request.auth != null && isRole(['teacher','admin']);
      }
      
      match /curriculum/{topicId} {
        allow read: if request.auth != null && isRole(['admin','rm','teacher','parent']);
        allow write: if request.auth != null && isRole(['teacher','admin']);
      }

      match /progress/{topicId} {
        allow read: if request.auth != null && isRole(['admin','rm','teacher','parent']);
        allow write: if request.auth != null && isRole(['teacher','admin']);
      }
    }

    // ---------- 🔹 PAYMENTS ----------
    match /payments/{pid} {
      allow read: if request.auth != null &&
        (isRole(['admin','rm']) || resource.data.parentId == request.auth.uid);
      allow write: if request.auth != null &&
        (isRole(['admin','rm']) || resource.data.parentId == request.auth.uid);
    }

    // ---------- 🔹 SESSIONS ----------
    match /sessions/{sid} {
      allow read: if request.auth != null && isRole(['admin','rm','teacher','parent']);
      allow write: if request.auth != null && isRole(['admin','rm','teacher']);
    }

    // ---------- 🔹 TEACHER NOTES ----------
    match /teacherNotes/{nid} {
      allow read: if request.auth != null &&
        (isRole(['admin','rm','teacher']) || resource.data.parentId == request.auth.uid);
      allow write: if request.auth != null && isRole(['admin','teacher']);
    }

    // ---------- 🔹 SUPPORT TICKETS ----------
    match /tickets/{tid} {
      allow read: if request.auth != null &&
        (isRole(['admin','rm']) || resource.data.parentId == request.auth.uid);
      allow write: if request.auth != null &&
        (isRole(['admin','rm']) || resource.data.parentId == request.auth.uid);
    }

    // ---------- 🔹 AUDIT LOGS (Admin only) ----------
    // Top-level (audit_logs) and nested paths (any prefix/audit_logs)
    match /audit_logs/{logId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }
    match /{prefix=**}/audit_logs/{logId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }

    // ---------- 🔹 SYSTEM STATS (Admin only) ----------
    // Top-level (system_stats/current) and nested paths
    match /system_stats/{statId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }
    match /{prefix=**}/system_stats/{statId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }

    // ---------- 🔹 ADMIN CONFIGS (Admin only) ----------
    match /admin_configs/{configId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }
    match /{prefix=**}/admin_configs/{configId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }

    // ---------- 🔹 COURSES (tenant-prefixed) ----------
    match /{prefix=**}/courses/{courseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isRole(['admin']) && isCourse(request.resource.data);
      allow update: if request.auth != null && isRole(['admin']) && isCourse(request.resource.data);
      allow delete: if request.auth != null && isRole(['admin']);
    }

    // Top-level courses collection
    match /courses/{courseId} {
      // Any signed-in user can read (for dropdowns / library views)
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.token.role == 'admin' && isCourse(request.resource.data);
      allow update: if request.auth != null && request.auth.token.role == 'admin' && isCourse(request.resource.data);
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // ---------- 🔹 COURSE STATS (Admin only) ----------
    match /{prefix=**}/courseStats/{statId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }

    // Top-level lessons collection - admin-only for analytics
    // Admins must be allowed to read lessons so the admin-only course
    // analytics page can compute stats by iterating lesson docs.
    match /lessons/{lessonId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // ---------- 🔹 SYSTEM SETTINGS (Admin only) ----------
    // Top-level camelCase variant
    match /systemSettings/{settingId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }
    // Tenant-prefixed camelCase
    match /{prefix=**}/systemSettings/{settingId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }
    // Tenant-prefixed snake_case variant
    match /{prefix=**}/system_settings/{settingId} {
      allow read, write: if request.auth != null && isRole(['admin']);
    }

    // ---------- 🔹 PARENTS & CHILD LINKS ----------
    // Parent documents and their `children` subcollection
    match /parents/{parentId} {
      // Parent can read their own doc; staff can also read
      allow read: if request.auth != null && (request.auth.uid == parentId || isRole(['admin','rm','teacher']));
      // Only admins can create/update/delete parent records
      allow create, update, delete: if request.auth != null && isRole(['admin']);

      match /children/{childId} {
        // Parent can read their children links; staff can also read
        allow read: if request.auth != null && (request.auth.uid == parentId || isRole(['admin','rm','teacher']));
        // Only admins can write child links (linking student accounts)
        allow create, update, delete: if request.auth != null && isRole(['admin']);
      }
    }
  }
}