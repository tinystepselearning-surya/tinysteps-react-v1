{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // Allow test files outside of src to be included without rootDir conflicts
    "rootDir": ".",
    // Ensure vitest globals and node types are available (merged with parent)
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "**/*.d.ts"
  ]
}
