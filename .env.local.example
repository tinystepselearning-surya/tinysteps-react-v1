# Optional local environment overrides
#
# Tiny Steps has public Firebase client defaults in src/lib/firebaseConfig.ts so
# CI/CD and production builds do not depend on a tracked .env.local file.
# Copy this template to .env.local only when you need local overrides.
# .env.local is ignored by Git and must never be committed.

# Firebase Configuration Overrides
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=G-YOUR_FIREBASE_MEASUREMENT_ID
VITE_GA_MEASUREMENT_ID=G-YOUR_GA_MEASUREMENT_ID

# Optional Sentry Configuration
VITE_SENTRY_DSN=YOUR_SENTRY_DSN

# Optional App Version Override
VITE_APP_VERSION=YOUR_APP_VERSION
