{
  "collectionName": "curriculum",
  "documentIdPattern": "courses/{courseId}/curriculum/{topicId}",
  "fields": {
    "topicId": {
      "type": "string",
      "description": "Unique identifier for the topic."
    },
    "courseId": {
      "type": "string",
      "description": "ID of the course this topic belongs to."
    },
    "title": {
      "type": "string",
      "description": "Title of the topic."
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the topic."
    },
    "order": {
      "type": "number",
      "description": "Order of the topic within the course."
    },
    "createdAt": {
      "type": "timestamp",
      "description": "Timestamp when the topic was created."
    },
    "updatedAt": {
      "type": "timestamp",
      "description": "Timestamp when the topic was last updated."
    }
  },
  "relationships": {
    "courseId": "courses/{courseId}"
  },
  "accessControl": {
    "read": ["admin", "teacher", "parent", "lp"],
    "write": ["admin"]
  },
  "compositeIndexes": [
    {
      "fields": ["courseId", "order"],
      "description": "For querying topics by course and order."
    }
  ],
  "validationConstraints": {
    "title": {
      "maxLength": 100,
      "description": "Title must not exceed 100 characters."
    },
    "order": {
      "min": 1,
      "description": "Order must be a positive integer."
    }
  }
}