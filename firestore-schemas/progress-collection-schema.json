{
  "collectionName": "progress",
  "documentIdPattern": "{studentId}_{topicId}",
  "fields": {
    "studentId": {
      "type": "string",
      "description": "UID of the student."
    },
    "topicId": {
      "type": "string",
      "description": "ID of the curriculum topic."
    },
    "courseId": {
      "type": "string",
      "description": "ID of the course this topic belongs to."
    },
    "progress": {
      "type": "number",
      "description": "Progress percentage (0-100)."
    },
    "lastUpdated": {
      "type": "timestamp",
      "description": "Timestamp when the progress was last updated."
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about the student’s progress."
    }
  },
  "relationships": {
    "studentId": "kids/{kidId}",
    "topicId": "courses/{courseId}/curriculum/{topicId}",
    "courseId": "courses/{courseId}"
  },
  "accessControl": {
    "read": ["admin", "teacher", "parent", "lp"],
    "write": ["admin", "teacher"]
  },
  "compositeIndexes": [
    {
      "fields": ["studentId", "courseId", "topicId"],
      "description": "For querying progress by student, course, and topic."
    },
    {
      "fields": ["courseId", "topicId"],
      "description": "For querying progress by course and topic."
    }
  ],
  "validationConstraints": {
    "progress": {
      "range": [0, 100],
      "description": "Must be a percentage between 0 and 100."
    }
  }
}