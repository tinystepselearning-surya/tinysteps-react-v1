{
  "name": "tinysteps-react-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:sitemaps && vite build && node scripts/write-build-info.mjs && node scripts/prerender.mjs && npm run seo:route-integrity && npm run seo:indexability-report && npm run seo:gsc-crawled-audit && npm run seo:gsc-archive-rendering && npm run seo:gsc-index-targets && npm run bundle:public-check && npm run content:offer-consistency && node scripts/write-indexnow-key.mjs",
    "prebuild": "npm run check:shadowing && node scripts/generate-rss.mjs",
    "generate:rss": "node scripts/generate-rss.mjs",
    "check:shadowing": "node scripts/check-shadowing.mjs",
    "content:offer-consistency": "node scripts/public-offer-consistency.mjs",
    "preview": "vite preview",
    "gen:sitemaps": "node scripts/generate-sitemaps.js",
    "seo:smoke": "node scripts/seo-smoke.mjs",
    "seo:indexation-check": "node scripts/seo-indexation-guard.mjs",
    "seo:rendered-check": "node scripts/seo-rendered-html-check.mjs",
    "seo:public-games-navigation": "node scripts/check-public-game-seo-navigation.mjs",
    "seo:route-integrity": "node scripts/seo-route-integrity.mjs",
    "seo:indexability-report": "node scripts/generate-route-indexability-report.mjs",
    "seo:gsc-crawled-audit": "node scripts/audit-gsc-crawled-not-indexed.mjs",
    "seo:gsc-archive-rendering": "node scripts/audit-gsc-archive-rendering.mjs",
    "seo:gsc-index-targets": "node scripts/write-gsc-index-submission-targets.mjs",
    "bundle:public-check": "node scripts/verify-public-bundle.mjs --max-gzip 150 --report artifacts/public-bundle-report.json",
    "verify:live-deployment": "node scripts/verify-live-deployment.mjs",
    "indexnow:submit": "node scripts/indexnow-submit.mjs",
    "audit:firebase-upgrade": "bash scripts/audit-firebase-upgrade.sh",
    "inventory:firebase-auth": "bash scripts/inventory-firebase-auth.sh",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test": "vitest run",
    "test:emulator:enrollment-integrity": "npm --prefix functions run build && npx firebase-tools@latest emulators:exec --project tinysteps-react-v1 --only auth,firestore,functions \"FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001 npx vitest run --config vitest.emulator.config.ts\"",
    "test:emulator:notifications": "npm --prefix functions run build && npx firebase-tools@latest emulators:exec --project tinysteps-react-v1 --only auth,firestore,functions \"FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001 npx vitest run --config vitest.notifications-emulator.config.ts\"",
    "serve": "vite preview",
    "cap:open:ios": "npx cap open ios",
    "cap:sync:ios": "npx cap sync ios",
    "cap:copy:ios": "npx cap copy ios",
    "dev:emulator": "VITE_USE_FIRESTORE_EMULATOR=true VITE_USE_AUTH_EMULATOR=true VITE_USE_FUNCTIONS_EMULATOR=true VITE_FIREBASE_EMULATOR_HOST=127.0.0.1 VITE_FIREBASE_AUTH_EMULATOR_PORT=9099 VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8085 VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001 vite",
    "pw:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/functions": "^4.2.1",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@sentry/react": "^10.23.0",
    "@sentry/tracing": "^7.120.4",
    "@tanstack/react-query": "^5.90.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.5.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "framer-motion": "^8.5.5",
    "got": "^14.6.5",
    "gsap": "^3.14.2",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.553.0",
    "ogl": "^1.0.11",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph": "^1.29.3",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.10.1",
    "react-speech-recognition": "^4.0.1",
    "recharts": "^3.4.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.167.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@babel/template": "^7.27.2",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@capacitor/cli": "^8.3.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/firebase": "^2.4.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.13",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.2",
    "csstype": "^3.1.3",
    "debug": "^4.4.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "form-data": "^4.0.4",
    "hersheytext": "^2.0.0",
    "jsdom": "^22.1.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.40.0",
    "postcss": "^8.5.6",
    "postinstall-postinstall": "^2.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.18",
    "tailwindcss-cli": "^0.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "undici-types": "^7.16.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.13"
  },
  "resolutions": {
    "got": "14.6.5"
  }
}
