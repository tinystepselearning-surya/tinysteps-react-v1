rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------
    // Helper functions
    // ----------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDocExists(uid) {
      return exists(userDocPath(uid));
    }

    // ✅ Safe role getter (only call after exists)
    // Normalizes to lowercase for case-insensitive comparison
    function userRole(uid) {
      return get(userDocPath(uid)).data.role.lower();
    }

    // Admin check:
    // - seeded UID (dev convenience)
    // - OR custom claim role == 'admin'
    // - OR Firestore users/{uid}.role == 'admin' (normalized)
    function isAdmin() {
      return isSignedIn() && (
        // dev convenience UID
        request.auth.uid == 'cwEYiYRydtOeeNRoCO0j3VSI2vE3' ||

        // custom claim (normalized)
        (request.auth.token != null && request.auth.token.role.lower() == 'admin') ||

        // users/{uid}.role == 'admin' (safe + normalized)
        (userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'admin')
      );
    }

    function isTeacher() {
      // ✅ Now accepts 'teacher', 'Teacher', 'TEACHER', etc.
      return isSignedIn() && userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'teacher';
    }

    function isParent() {
      // ✅ Now accepts 'parent', 'Parent', 'PARENT', etc.
      return isSignedIn() && userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'parent';
    }

    function isLP() {
      // ✅ Now accepts both spellings, any casing
      return isSignedIn() && userDocExists(request.auth.uid) && (
        userRole(request.auth.uid) == 'learningpartner' ||
        userRole(request.auth.uid) == 'learning-partner'
      );
    }

    function isKid() {
      // ✅ Now accepts 'kid', 'Kid', 'KID', etc.
      return isSignedIn() && userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'kid';
    }

    function touchesAssignmentFields() {
      return
        ('assignedLPs' in request.resource.data) ||
        ('assignedParents' in request.resource.data) ||
        ('assignedTeachers' in request.resource.data);
    }

    function touchesRoleField() {
      return ('role' in request.resource.data) && (request.resource.data.role != resource.data.role);
    }

    // ----------------------------
    // Public game reference data
    // ----------------------------
    match /gameData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------
    // USERS COLLECTION
    // ----------------------------
    match /users/{uid} {
      allow read: if isSignedIn();

      // Admin only
      allow create, delete: if isAdmin();

      // Update:
      // - Admin can update anything
      // - User can update own profile except role + assignment fields
      allow update: if isAdmin()
        || (
          request.auth.uid == uid
          && !touchesAssignmentFields()
          && !touchesRoleField()
        );
    }

    match /users/{userId}/progress/{document=**} {
      allow read, write, create: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/gameStats/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /teachers/{teacherId}/classes/{classId}/studentMetrics/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == teacherId;
    }

    // ----------------------------
    // KIDS COLLECTION
    // ----------------------------
    match /kids/{kidId} {
      // Admin full access
      allow read, write: if isAdmin();

      // Parent read own kids
      allow read: if isParent() && resource.data.parentId == request.auth.uid;

      // Teacher conservative read
      allow read: if isTeacher();

      // LP read if assignedLPs array exists & contains uid
      allow read: if isLP()
        && ('assignedLPs' in resource.data)
        && (request.auth.uid in resource.data.assignedLPs);
    }

    // ----------------------------
    // ENROLLMENTS COLLECTION
    // ----------------------------
    match /enrollments/{enrollmentId} {
      allow read, write: if isAdmin();
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow read: if isLP() && resource.data.lpId == request.auth.uid;
    }

    // ----------------------------
    // SESSIONS COLLECTION
    // ----------------------------
    match /sessions/{sessionId} {
      allow read, write: if isAdmin();
      allow read, write: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow read: if isParent() && resource.data.parentId == request.auth.uid;

      // Kid read if kidIds exists and contains uid
      allow read: if isKid()
        && ('kidIds' in resource.data)
        && (request.auth.uid in resource.data.kidIds);
    }

    // ----------------------------
    // MESSAGES COLLECTION
    // Teachers should only read messages where they are a participant
    // Messages are expected to have a `participants` array containing user uids
    // and fields `fromId` / `toId` for sender/recipient.
    // ----------------------------
    match /messages/{messageId} {
      // Admin full access
      allow read, create, update, delete: if isAdmin();

      // Teacher read only if they are a participant
      allow read: if isTeacher()
        && ('participants' in resource.data)
        && (request.auth.uid in resource.data.participants);

      // Allow creating a message if signed in and the sender matches
      allow create: if isSignedIn()
        && ('fromId' in request.resource.data)
        && request.auth.uid == request.resource.data.fromId;

      // Prevent updates/deletes for non-admins
      allow update, delete: if false;
    }

    // ----------------------------
    // PROGRESS COLLECTION
    // ----------------------------
    match /progress/{progressId} {
      allow read, write: if isAdmin();
      allow read: if isTeacher() || isParent() || isLP();
      allow write: if false;
    }

    // ----------------------------
    // INVOICES COLLECTION
    // ----------------------------
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow read: if isLP() && resource.data.lpId == request.auth.uid;
    }

    // ----------------------------
    // COURSES COLLECTION
    // ----------------------------
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // LESSON LIBRARY: lessonFolders + lessons
    // Admin: read + write
    // Teacher: read only
    // Everyone else: no access
    // ----------------------------
    match /lessonFolders/{folderId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // LESSON VIEW AUDIT: lesson_view_audit
    // Teachers can create/update only their own audit docs where teacherId == auth.uid
    // Admin can read all
    // ----------------------------
    match /lesson_view_audit/{sessionId} {
      allow read: if isAdmin();
      
      // Teachers can create audit docs where teacherId matches their uid
      allow create: if isTeacher() 
        && request.resource.data.teacherId == request.auth.uid;
      
      // Teachers can update only their own audit docs
      allow update: if isTeacher() 
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;
      
      allow delete: if isAdmin();
    }

    // ----------------------------
    // NOTIFICATIONS COLLECTION
    // ----------------------------
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /bulkUploadJobs/{jobId} {
      allow create, read, update, delete: if isAdmin();
    }

    match /ai-usage-logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /ai-error-logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /adminStats/{document=**} {
      allow read, write: if isAdmin();
    }

    match /debug/{doc=**} {
      allow read, write: if isSignedIn();
    }
  }
}
