rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function hasRole(role) {
      return request.auth.token[role] == true;
    }

    function isOwnData(uid) {
      return request.auth.uid == uid;
    }

    function isParentOfKid(kidId) {
      return hasRole('parent') &&
             get(/databases/$(database)/documents/kids/$(kidId)).data.parentId == request.auth.uid;
    }

    function isTeacherOfKid(kidId) {
      return hasRole('teacher') &&
             get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid;
    }

    function isLPOfKid(kidId) {
      return hasRole('learning_partner') &&
             get(/databases/$(database)/documents/kids/$(kidId)).data.lpId == request.auth.uid;
    }

    function isTeacherOfSession(sessionId) {
      return hasRole('teacher') &&
             get(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherId == request.auth.uid;
    }

    // Collection Rules

    match /users/{uid} {
      allow read: if hasRole('admin') || isOwnData(uid);
      allow create: if false;
      allow update: if hasRole('admin') ||
                     (isOwnData(uid) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'email', 'phone']));
      allow delete: if hasRole('admin');
    }

    match /kids/{kidId} {
      allow read: if hasRole('admin') ||
                     isParentOfKid(kidId) ||
                     isTeacherOfKid(kidId) ||
                     isLPOfKid(kidId) ||
                     isOwnData(kidId);
      allow create, update, delete: if hasRole('admin');
    }

    match /sessions/{sessionId} {
      allow read: if hasRole('admin') ||
                     isTeacherOfSession(sessionId) ||
                     (hasRole('parent') &&
                      request.auth.uid in resource.data.kidIds) ||
                     (hasRole('learning_partner') &&
                      request.auth.uid in resource.data.lpId);
      allow create, update: if hasRole('admin') || isTeacherOfSession(sessionId);
      allow delete: if hasRole('admin');
    }

    match /attendance/{sessionId}/attendanceRecords/{date} {
      allow read: if hasRole('admin') ||
                     isTeacherOfSession(sessionId) ||
                     (hasRole('parent') &&
                      request.auth.uid in resource.data.kidIds) ||
                     isOwnData(request.auth.uid);
      allow write: if hasRole('admin') || isTeacherOfSession(sessionId);
    }

    match /progress/{studentId}_{topicId} {
      allow read: if hasRole('admin') ||
                     (hasRole('teacher') &&
                      request.auth.uid in resource.data.teacherId) ||
                     (hasRole('parent') &&
                      request.auth.uid in resource.data.parentId) ||
                     isOwnData(studentId) ||
                     (hasRole('learning_partner') &&
                      request.auth.uid in resource.data.lpId);
      allow write: if hasRole('admin') ||
                     (hasRole('teacher') &&
                      request.auth.uid in resource.data.teacherId);
    }

    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if hasRole('admin');
    }

    match /courses/{courseId}/curriculum/{topicId} {
      allow read: if request.auth != null;
      allow create, update, delete: if hasRole('admin');
    }

    match /invoices/{invoiceId} {
      allow read: if hasRole('admin') ||
                     (hasRole('parent') &&
                      request.auth.uid in resource.data.parentId) ||
                     (hasRole('learning_partner') &&
                      request.auth.uid in resource.data.lpId);
      allow create, update, delete: if hasRole('admin');
    }

    match /materials/{materialId} {
      allow read: if request.auth != null &&
                     (resource.data.audience == null ||
                      request.auth.token.role in resource.data.audience);
      allow create, update, delete: if hasRole('admin');
    }

    match /gameProgress/{kidId}_{gameId} {
      allow read: if hasRole('admin') ||
                     (hasRole('parent') &&
                      request.auth.uid in resource.data.parentId) ||
                     isOwnData(kidId);
      allow write: if isOwnData(kidId);
    }

    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create, update, delete: if hasRole('admin');
    }

    match /enrollments/{enrollmentId} {
      allow read: if hasRole('admin') ||
                     (hasRole('parent') &&
                      request.auth.uid in resource.data.parentId) ||
                     (hasRole('learning_partner') &&
                      request.auth.uid in resource.data.lpId);
      allow create, update, delete: if hasRole('admin');
    }
  }
}