rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------
    // Helper functions
    // ----------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDocExists(uid) {
      return exists(userDocPath(uid));
    }

    // ✅ Safe role getter (only call after exists)
    function userRole(uid) {
      return get(userDocPath(uid)).data.role.lower();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'cwEYiYRydtOeeNRoCO0j3VSI2vE3' ||
        (request.auth.token != null && request.auth.token.role.lower() == 'admin') ||
        (userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'admin')
      );
    }

    function isTeacher() {
      return isSignedIn() && userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'teacher';
    }

    function isParent() {
      return isSignedIn() && userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'parent';
    }

    function isLP() {
      return isSignedIn() && userDocExists(request.auth.uid) && (
        userRole(request.auth.uid) == 'learningpartner' ||
        userRole(request.auth.uid) == 'learning-partner'
      );
    }

    function isKid() {
      return isSignedIn() && userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'kid';
    }

    function touchesAssignmentFields() {
      return
        ('assignedLPs' in request.resource.data) ||
        ('assignedParents' in request.resource.data) ||
        ('assignedTeachers' in request.resource.data);
    }

    function touchesRoleField() {
      return ('role' in request.resource.data) && (request.resource.data.role != resource.data.role);
    }

    // ----------------------------
    // Kids helper functions (NO "let" usage)
    // ----------------------------
    function kidDocPath(kidId) {
      return /databases/$(database)/documents/kids/$(kidId);
    }

    function kidExists(kidId) {
      return exists(kidDocPath(kidId));
    }

    function kidDoc(kidId) {
      return get(kidDocPath(kidId)).data;
    }

    // Who can read kid + kid subcollections
    function canAccessKid(kidId) {
      return isAdmin()
        || isTeacher()
        || (
          isParent()
          && kidExists(kidId)
          && ('parentIds' in kidDoc(kidId))
          && (request.auth.uid in kidDoc(kidId).parentIds)
        )
        || (
          isLP()
          && kidExists(kidId)
          && ('assignedLPs' in kidDoc(kidId))
          && (request.auth.uid in kidDoc(kidId).assignedLPs)
        )
        // Optional: if you later store kid's auth uid on kid doc
        || (
          isKid()
          && kidExists(kidId)
          && ('userId' in kidDoc(kidId))
          && (kidDoc(kidId).userId == request.auth.uid)
        );
    }

    function isParentOfKid(kidId) {
      return isParent()
        && kidExists(kidId)
        && (
          (('parentIds' in kidDoc(kidId)) &&
            (
              ((kidDoc(kidId).parentIds is list) && (request.auth.uid in kidDoc(kidId).parentIds)) ||
              ((kidDoc(kidId).parentIds is string) && (kidDoc(kidId).parentIds == request.auth.uid))
            )
          ) ||
          (('primaryParentId' in kidDoc(kidId)) && (kidDoc(kidId).primaryParentId == request.auth.uid)) ||
          (('parentId' in kidDoc(kidId)) && (kidDoc(kidId).parentId == request.auth.uid))
        );
    }

    // ----------------------------
    // Public game reference data
    // ----------------------------
    match /gameData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------
    // USERS COLLECTION
    // ----------------------------
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          request.auth.uid == uid
          && !touchesAssignmentFields()
          && !touchesRoleField()
        );
    }

    match /users/{userId}/progress/{document=**} {
      allow read, write, create: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/gameStats/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /teachers/{teacherId}/classes/{classId}/studentMetrics/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == teacherId;
    }

    match /teachers/{teacherId}/blockedSlots/{blockId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == teacherId;
    }

    match /teachers/{teacherId}/sessionRequests/{requestId} {
      allow read, create, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == teacherId);
    }

    // ----------------------------
    // KIDS COLLECTION
    // ----------------------------
    match /kids/{kidId} {
      // Admin full access
      allow read, write: if isAdmin();

      // Parent read own kids (check parentIds array)
      // Allow if authenticated user's uid is in the kid's parentIds array
      allow read: if isSignedIn()
        && ('parentIds' in resource.data)
        && (request.auth.uid in resource.data.parentIds);

      // Teacher conservative read (as you had it)
      allow read: if isTeacher();

      // LP read if assignedLPs array exists & contains uid
      allow read: if isLP()
        && ('assignedLPs' in resource.data)
        && (request.auth.uid in resource.data.assignedLPs);
    }

    // ----------------------------
    // KIDS SUBCOLLECTIONS: progress & curriculum
    // ----------------------------
    match /kids/{kidId}/progress/{topicId} {
      allow read: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid)
        || (isParent() && get(/databases/$(database)/documents/kids/$(kidId)).data.primaryParentId == request.auth.uid);

      allow create, update, delete: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid);
    }

    match /kids/{kidId}/curriculum/{topicId} {
      allow read: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid)
        || (isParent() && get(/databases/$(database)/documents/kids/$(kidId)).data.primaryParentId == request.auth.uid);

      allow create, update, delete: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid);
    }

    // ----------------------------
    // STUDENTS SUBCOLLECTIONS: progress & curriculum
    // (Mirror /kids subcollections for existing code compatibility)
    // ----------------------------
    match /students/{kidId}/progress/{topicId} {
      allow read: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid)
        || isParentOfKid(kidId);

      allow create, update, delete: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid);
    }

    match /students/{kidId}/curriculum/{topicId} {
      allow read: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid)
        || isParentOfKid(kidId);

      allow create, update, delete: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid);
    }

    match /students/{kidId} {
      allow read: if isAdmin()
        || (isTeacher() && get(/databases/$(database)/documents/kids/$(kidId)).data.teacherId == request.auth.uid)
        || (isParent() && get(/databases/$(database)/documents/kids/$(kidId)).data.primaryParentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ✅ NEW: Game sessions under kid (write + read)
    match /kids/{kidId}/gameSessions/{sessionId} {
      // Read for anyone who can access this kid
      allow read: if isSignedIn() && canAccessKid(kidId);

      // Create only (no edits/deletes) to prevent tampering
      allow create: if isSignedIn()
        && canAccessKid(kidId)
        && ('createdByUid' in request.resource.data)
        && (request.resource.data.createdByUid == request.auth.uid);

      allow update, delete: if false;
    }

    // (Optional) future aggregated game progress docs
    match /kids/{kidId}/gameProgress/{docId} {
      allow read: if isSignedIn() && canAccessKid(kidId);

      // ✅ allow client to save progress (no delete)
      allow create, update: if isSignedIn() && canAccessKid(kidId);

      allow delete: if false;
    }

    // Skill stats per tag (written by Cloud Functions, read by parents/admins)
    match /kids/{kidId}/skillStats/{tagId} {
      // Parents can read their kids' skill stats
      allow read: if isSignedIn()
        && kidExists(kidId)
        && ('parentIds' in kidDoc(kidId))
        && (request.auth.uid in kidDoc(kidId).parentIds);

      // Admins can read
      allow read: if isAdmin();

      // Only backend (Cloud Functions) can write - deny all client writes
      allow write: if false;
    }

    // ----------------------------
    // ENROLLMENTS COLLECTION
    // ----------------------------
    match /enrollments/{enrollmentId} {
      allow read, write: if isAdmin();
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow read: if isLP() && resource.data.lpId == request.auth.uid;
    }

    // ----------------------------
    // SESSIONS COLLECTION
    // ----------------------------
    match /sessions/{sessionId} {
      allow read, write: if isAdmin();
      allow read, write: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow read: if isParent() && resource.data.parentId == request.auth.uid;

      allow read: if isKid()
        && ('kidIds' in resource.data)
        && (request.auth.uid in resource.data.kidIds);
    }

    // ----------------------------
    // BILLING CHARGES COLLECTION
    // ----------------------------
    match /billingCharges/{chargeId} {
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // MESSAGES COLLECTION
    // ----------------------------
    match /messages/{messageId} {
      allow read, create, update, delete: if isAdmin();

      allow read: if isTeacher()
        && ('participants' in resource.data)
        && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && ('fromId' in request.resource.data)
        && request.auth.uid == request.resource.data.fromId;

      allow update, delete: if false;
    }

    // ----------------------------
    // PROGRESS COLLECTION
    // ----------------------------
    match /progress/{progressId} {
      allow read, write: if isAdmin();
      allow read: if isTeacher() || isParent() || isLP();
      allow write: if false;
    }

    // ----------------------------
    // INVOICES COLLECTION
    // ----------------------------
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow read: if isLP() && resource.data.lpId == request.auth.uid;
    }

    // ----------------------------
    // COURSES COLLECTION
    // ----------------------------
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // LESSON LIBRARY
    // ----------------------------
    match /lessonFolders/{folderId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // LESSON VIEW AUDIT
    // ----------------------------
    match /lesson_view_audit/{sessionId} {
      allow read: if isAdmin();

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ----------------------------
    // NOTIFICATIONS
    // ----------------------------
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /bulkUploadJobs/{jobId} {
      allow create, read, update, delete: if isAdmin();
    }

    match /ai-usage-logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /ai-error-logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /adminStats/{document=**} {
      allow read, write: if isAdmin();
    }

    match /debug/{doc=**} {
      allow read, write: if isSignedIn();
    }

    // ----------------------------
    // CONFIG COLLECTION
    // ----------------------------
    // config/gamesCatalog: readable by authenticated users (especially parents for dashboard)
    match /config/gamesCatalog {
      allow read: if isSignedIn();
      allow write: if false; // only server-side/admin SDK should write
    }

    match /config/picklists {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /config/curriculumTopics {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /config/insights {
      allow read: if isAdmin();
      allow write: if false; // only callable (admin SDK) should write
    }
  }
}
