rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------
    // Helper functions
    // ----------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDocExists(uid) {
      return exists(userDocPath(uid));
    }

    // ✅ Safe role getter (only call after exists)
    function userRole(uid) {
      return get(userDocPath(uid)).data.role.lower();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'cwEYiYRydtOeeNRoCO0j3VSI2vE3' ||
        (request.auth.token != null && request.auth.token.role.lower() == 'admin') ||
        (
          request.auth.token != null
          && request.auth.token.email is string
          && request.auth.token.email.lower() == 'suryaz@tinysteps.com'
        ) ||
        (
          userDocExists(request.auth.uid)
          && ('superUser' in get(userDocPath(request.auth.uid)).data)
          && get(userDocPath(request.auth.uid)).data.superUser == true
        ) ||
        (userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'admin')
      );
    }

    function tokenRole() {
      return isSignedIn()
        && request.auth.token != null
        && request.auth.token.role is string
        ? request.auth.token.role.lower()
        : '';
    }

    function isAdminToken() {
      return tokenRole() == 'admin';
    }

    function isTeacherToken() {
      return tokenRole() == 'teacher';
    }

    function isParentToken() {
      return tokenRole() == 'parent';
    }

    function isLPToken() {
      return tokenRole() == 'learningpartner' || tokenRole() == 'learning-partner';
    }

    function isKidToken() {
      return tokenRole() == 'kid';
    }

    function isTeacher() {
      return isSignedIn() && (
        isTeacherToken()
        || (userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'teacher')
      );
    }

    function isTeacherOrAdmin() {
      return isTeacher() || isAdmin();
    }

    function isParent() {
      return isSignedIn() && (
        isParentToken()
        || (userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'parent')
      );
    }

    function isLP() {
      return isSignedIn() && (
        isLPToken()
        || (
          userDocExists(request.auth.uid) && (
            userRole(request.auth.uid) == 'learningpartner' ||
            userRole(request.auth.uid) == 'learning-partner'
          )
        )
      );
    }

    function isKid() {
      return isSignedIn() && (
        isKidToken()
        || (userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'kid')
      );
    }

    function touchesAssignmentFields() {
      return
        ('assignedLPs' in request.resource.data) ||
        ('assignedParents' in request.resource.data) ||
        ('assignedTeachers' in request.resource.data);
    }

    function touchesRoleField() {
      return ('role' in request.resource.data) && (request.resource.data.role != resource.data.role);
    }

    function messageThreadDocPath(threadId) {
      return /databases/$(database)/documents/messageThreads/$(threadId);
    }

    function messageThreadExists(threadId) {
      return exists(messageThreadDocPath(threadId));
    }

    function isMessageThreadParticipant(threadId) {
      return isSignedIn()
        && messageThreadExists(threadId)
        && ('participantIds' in get(messageThreadDocPath(threadId)).data)
        && (request.auth.uid in get(messageThreadDocPath(threadId)).data.participantIds);
    }

    // ----------------------------
    // Kids helper functions (NO "let" usage)
    // ----------------------------
    function kidDocPath(kidId) {
      return /databases/$(database)/documents/kids/$(kidId);
    }

    function kidExists(kidId) {
      return exists(kidDocPath(kidId));
    }

    function kidDoc(kidId) {
      return get(kidDocPath(kidId)).data;
    }

    // Students helper functions (progress/curriculum live under /students)
    function studentDocPath(kidId) {
      return /databases/$(database)/documents/students/$(kidId);
    }

    function studentExists(kidId) {
      return exists(studentDocPath(kidId));
    }

    function studentDoc(kidId) {
      return get(studentDocPath(kidId)).data;
    }

    // Who can read kid + kid subcollections
    function canAccessKid(kidId) {
      return isAdmin()
        || isTeacher()
        || (
          isParent()
          && kidExists(kidId)
          && ('parentIds' in kidDoc(kidId))
          && (request.auth.uid in kidDoc(kidId).parentIds)
        )
        || (
          isLP()
          && kidExists(kidId)
          && ('assignedLPs' in kidDoc(kidId))
          && (request.auth.uid in kidDoc(kidId).assignedLPs)
        )
        // Optional: if you later store kid's auth uid on kid doc
        || (
          isKid()
          && kidExists(kidId)
          && ('userId' in kidDoc(kidId))
          && (kidDoc(kidId).userId == request.auth.uid)
        );
    }

    function isParentOfKid(kidId) {
  return isParent()
    && (
      (
        kidExists(kidId)
        && (
          (
            ('parentIds' in kidDoc(kidId))
            && (
              ((kidDoc(kidId).parentIds is list) && (request.auth.uid in kidDoc(kidId).parentIds))
              || ((kidDoc(kidId).parentIds is string) && (kidDoc(kidId).parentIds == request.auth.uid))
            )
          )
          || (('primaryParentId' in kidDoc(kidId)) && (kidDoc(kidId).primaryParentId == request.auth.uid))
          || (('parentId' in kidDoc(kidId)) && (kidDoc(kidId).parentId == request.auth.uid))
        )
      )
      ||
      (
        studentExists(kidId)
        && (
          (
            ('parentIds' in studentDoc(kidId))
            && (
              ((studentDoc(kidId).parentIds is list) && (request.auth.uid in studentDoc(kidId).parentIds))
              || ((studentDoc(kidId).parentIds is string) && (studentDoc(kidId).parentIds == request.auth.uid))
            )
          )
          || (('primaryParentId' in studentDoc(kidId)) && (studentDoc(kidId).primaryParentId == request.auth.uid))
          || (('parentId' in studentDoc(kidId)) && (studentDoc(kidId).parentId == request.auth.uid))
        )
      )
    );
}

function isTeacherOfKid(kidId) {
  return isSignedIn()
    && kidExists(kidId)
    && (
      (('teacherId' in kidDoc(kidId)) && kidDoc(kidId).teacherId == request.auth.uid)
      || (
        ('teacherIds' in kidDoc(kidId))
        && (kidDoc(kidId).teacherIds is list)
        && (request.auth.uid in kidDoc(kidId).teacherIds)
      )
      || (('assignedTeacherId' in kidDoc(kidId)) && kidDoc(kidId).assignedTeacherId == request.auth.uid)
      || (('primaryTeacherId' in kidDoc(kidId)) && kidDoc(kidId).primaryTeacherId == request.auth.uid)
      || (('teacherUid' in kidDoc(kidId)) && kidDoc(kidId).teacherUid == request.auth.uid)
      || (('teacher_id' in kidDoc(kidId)) && kidDoc(kidId).teacher_id == request.auth.uid)
    );
}

function teacherOwnsDocViaAliases(data) {
  return isSignedIn()
    && (
      (('teacherId' in data) && data.teacherId == request.auth.uid)
      || (
        ('teacherIds' in data)
        && (data.teacherIds is list)
        && (request.auth.uid in data.teacherIds)
      )
      || (('assignedTeacherId' in data) && data.assignedTeacherId == request.auth.uid)
      || (('primaryTeacherId' in data) && data.primaryTeacherId == request.auth.uid)
      || (('teacherUid' in data) && data.teacherUid == request.auth.uid)
      || (('teacher_id' in data) && data.teacher_id == request.auth.uid)
    );
}

    // Class session schema guardrail (canonical collection)
    function isValidClassSession(data) {
      return data.keys().hasAll([
        "enrollmentId",
        "teacherId",
        "parentId",
        "kidIds",
        "courseId",
        "status",
        "startAt",
        "endAt"
      ])
        && data.enrollmentId is string
        && data.teacherId is string
        && data.parentId is string
        && data.kidIds is list
        && data.kidIds.size() == 1
        && data.kidIds[0] is string
        && (!("kidId" in data) || (data.kidId is string && data.kidId == data.kidIds[0]))
        && data.courseId is string
        && data.status in ["scheduled", "in_progress", "completed", "cancelled", "reschedule_requested"]
        && data.startAt is timestamp
        && data.endAt is timestamp;
    }

    function teacherClassSessionOperationalUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "attendance",
        "notes",
        "updatedAt",
        "updatedBy",
        "status"
      ]);
    }

    function teacherClassSessionStateMutableForTeacher() {
      return !(resource.data.status in [
        "completed",
        "cancelled",
        "canceled",
        "reschedule_requested",
        "rescheduled",
        "consumed",
        "settled",
        "paid",
        "locked"
      ])
        && !(("revenueAccrued" in resource.data) && resource.data.revenueAccrued == true)
        && !(("creditsProcessed" in resource.data) && resource.data.creditsProcessed == true)
        && !(("creditsProcessing" in resource.data) && resource.data.creditsProcessing == true)
        && !(("locked" in resource.data) && resource.data.locked == true)
        && !(("isLocked" in resource.data) && resource.data.isLocked == true);
    }

    function teacherClassSessionStatusAllowed() {
      return request.resource.data.status == resource.data.status
        || (
          resource.data.status in ["scheduled", "upcoming", "planned", "open"]
          && request.resource.data.status in ["in_progress", "reschedule_requested"]
        )
        || (
          resource.data.status == "in_progress"
          && request.resource.data.status == "reschedule_requested"
        );
    }

    // ----------------------------
    // Public game reference data
    // ----------------------------
    match /gameData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------
    // USERS COLLECTION
    // ----------------------------
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          request.auth.uid == uid
          && !touchesAssignmentFields()
          && !touchesRoleField()
        );
    }

    match /users/{userId}/progress/{document=**} {
      allow read, write, create: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/gameStats/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /teachers/{teacherId}/classes/{classId}/studentMetrics/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == teacherId;
    }

    match /teachers/{teacherId}/blockedSlots/{blockId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == teacherId);
      allow create, update, delete: if isSignedIn() && request.auth.uid == teacherId;
    }

    match /teachers/{teacherId}/availability/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == teacherId);
      allow create, update, delete: if isSignedIn() && request.auth.uid == teacherId;
    }

    match /teachers/{teacherId}/earnings/{docId} {
      allow read: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);
      allow write: if false;
    }

    match /{path=**}/earnings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /teachers/{teacherId}/sessionRequests/{requestId} {
      allow read, create, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == teacherId);
    }

    // Allow admins to query sessionRequests across all teachers (collection group query)
    match /{path=**}/sessionRequests/{requestId} {
      allow read: if isAdmin();
    }

    // ----------------------------
    // KIDS COLLECTION
    // ----------------------------
    match /kids/{kidId} {
      // Admin full access
      allow read, write: if isAdmin();

      // Parent read own kids (check parentIds array)
      // Allow if authenticated user's uid is in the kid's parentIds array
      allow read: if isSignedIn()
        && ('parentIds' in resource.data)
        && (request.auth.uid in resource.data.parentIds);

      // Teacher read only for teacher-owned kids through supported teacher alias fields.
      allow read: if isTeacher() && teacherOwnsDocViaAliases(resource.data);

      // LP read if assignedLPs array exists & contains uid
      allow read: if isLP()
        && ('assignedLPs' in resource.data)
        && (request.auth.uid in resource.data.assignedLPs);
    }

    // ----------------------------
    // KIDS SUBCOLLECTIONS: progress & curriculum
    // ----------------------------
    match /kids/{kidId}/progress/{topicId} {
      allow read: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId))
        || (isParent() && get(/databases/$(database)/documents/kids/$(kidId)).data.primaryParentId == request.auth.uid);

      allow create, update, delete: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId));
    }

    match /kids/{kidId}/curriculum/{topicId} {
      allow read: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId))
        || (isParent() && get(/databases/$(database)/documents/kids/$(kidId)).data.primaryParentId == request.auth.uid);

      allow create, update, delete: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId));
    }

    // ----------------------------
    // STUDENTS SUBCOLLECTIONS: progress & curriculum
    // (Mirror /kids subcollections for existing code compatibility)
    // ----------------------------
    match /students/{kidId}/progress/{topicId} {
      allow read: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId))
        || isParentOfKid(kidId);

      allow create, update, delete: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId));
    }

    match /students/{kidId}/curriculum/{topicId} {
      allow read: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId))
        || isParentOfKid(kidId);

      allow create, update, delete: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId));
    }

    match /students/{kidId}/weeklyReports/{reportId} {
      allow read: if isAdmin()
        || (
          isTeacher()
          && kidExists(kidId)
          && ('teacherIds' in kidDoc(kidId))
          && (request.auth.uid in kidDoc(kidId).teacherIds)
        )
        || (isParentOfKid(kidId) && resource.data.status == "published");

      allow create, update, delete: if isAdmin()
        || (
          isTeacher()
          && kidExists(kidId)
          && ('teacherIds' in kidDoc(kidId))
          && (request.auth.uid in kidDoc(kidId).teacherIds)
        );
    }

    match /students/{kidId}/monthlyReports/{docId} {
      allow read: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId))
        || (isParentOfKid(kidId) && resource.data.status == "published");

      allow create, update, delete: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId));
    }

    match /students/{kidId} {
      allow read: if isAdmin()
        || (isTeacher() && isTeacherOfKid(kidId))
        || (isParent() && get(/databases/$(database)/documents/kids/$(kidId)).data.primaryParentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ✅ NEW: Game sessions under kid (write + read)
    match /kids/{kidId}/gameSessions/{sessionId} {
      // Read for anyone who can access this kid
      allow read: if isSignedIn() && canAccessKid(kidId);

      // Create only (no edits/deletes) to prevent tampering
      allow create: if isSignedIn()
        && canAccessKid(kidId)
        && ('createdByUid' in request.resource.data)
        && (request.resource.data.createdByUid == request.auth.uid);

      allow update, delete: if false;
    }

    // (Optional) future aggregated game progress docs
    match /kids/{kidId}/gameProgress/{docId} {
      allow read: if isSignedIn() && canAccessKid(kidId);

      // ✅ allow client to save progress (no delete)
      allow create, update: if isSignedIn() && canAccessKid(kidId);

      allow delete: if false;
    }

    // Parent-facing per-game summaries materialized from gameProgress
    match /kids/{kidId}/gameSummaries/{docId} {
      allow read: if isSignedIn() && canAccessKid(kidId);
      // Written by backend triggers/admin SDK only
      allow write: if false;
    }

    // Lightweight freshness head for parent Games refresh checks
    match /kids/{kidId}/activity/{docId} {
      allow read: if isSignedIn() && canAccessKid(kidId);
      // Backend-maintained only
      allow write: if false;
    }

    // Legacy summary subcollection compatibility surface.
    // Canonical parent game reads are:
    // - /kids/{kidId}/gameSummaries/{docId}
    // - /kids/{kidId}/gameProgress/{docId}
    // This path is retained as read-only compatibility; no active in-repo
    // writer currently maintains /kids/{kidId}/summary/overall.
    match /kids/{kidId}/summary/{docId} {
      allow read: if isSignedIn() && canAccessKid(kidId);
      // Backend/client writes blocked (legacy frozen surface).
      allow write: if false;
    }

    // Skill stats per tag (written by Cloud Functions, read by parents/admins)
    match /kids/{kidId}/skillStats/{tagId} {
      // Parents can read their kids' skill stats
      allow read: if isSignedIn()
        && kidExists(kidId)
        && ('parentIds' in kidDoc(kidId))
        && (request.auth.uid in kidDoc(kidId).parentIds);

      // Admins can read
      allow read: if isAdmin();

      // Only backend (Cloud Functions) can write - deny all client writes
      allow write: if false;
    }

    // Active per-tag stats path written by onGameSessionCreate trigger
    match /kids/{kidId}/skillTagStats/{tagId} {
      allow read: if isSignedIn()
        && kidExists(kidId)
        && ('parentIds' in kidDoc(kidId))
        && (request.auth.uid in kidDoc(kidId).parentIds);

      allow read: if isAdmin();

      // Only backend (Cloud Functions) can write - deny all client writes
      allow write: if false;
    }

    // Internal idempotency markers for backend rollups
    match /kids/{kidId}/rollupsApplied/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Internal level completion markers for backend rollups
    match /kids/{kidId}/levelCompletions/{markerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----------------------------
    // ENROLLMENTS COLLECTION
    // ----------------------------
    match /enrollments/{enrollmentId} {
      allow read, write: if isAdmin();
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow read: if isTeacher() && teacherOwnsDocViaAliases(resource.data);
      allow read: if isLP() && resource.data.lpId == request.auth.uid;
    }

    // ----------------------------
    // LEGACY SESSIONS COLLECTION (LOCKED)
    // ----------------------------
    match /sessions/{document=**} {
      allow read, write: if false;
    }

    // ----------------------------
    // CLASS SESSIONS COLLECTION
    // ----------------------------
    match /classSessions/{sessionId} {
      allow get: if isAdmin()
        || teacherOwnsDocViaAliases(resource.data)
        || (isParent() && resource.data.parentId == request.auth.uid)
        || (isKid() && ('kidIds' in resource.data) && (request.auth.uid in resource.data.kidIds));

      allow list: if isAdmin()
        || teacherOwnsDocViaAliases(resource.data)
        || (isParentToken() && resource.data.parentId == request.auth.uid)
        || (isKidToken() && ('kidIds' in resource.data) && (request.auth.uid in resource.data.kidIds));

      allow create: if isValidClassSession(request.resource.data)
        && isAdmin();

      allow update: if isValidClassSession(request.resource.data)
        && isAdmin();

      allow delete: if isAdmin();
    }

    // ----------------------------
    // RESCHEDULE CREDITS COLLECTION
    // ----------------------------
    match /rescheduleCredits/{creditId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isParent()
          && ('parentId' in resource.data)
          && resource.data.parentId == request.auth.uid);

      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);

      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == resource.data.teacherId);

      allow delete: if isAdmin();
    }

    // ----------------------------
    // PARENT CLASS RECORDINGS
    // ----------------------------
    match /parentClassRecordings/{recordingId} {
      allow read: if isAdmin()
        || (isParent() && resource.data.parentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // CLASS SAMPLES
    // ----------------------------
    match /classSamples/{sampleId} {
      // Admins have full control
      allow create, update, delete: if isAdmin();

      // Public can read active samples, Admins can read all
      allow read: if resource.data.active == true || isAdmin();
    }

    // ----------------------------
    // TESTIMONIALS
    // ----------------------------
    match /testimonials/{testimonialId} {
      // Public site can read approved testimonials only.
      allow read: if (resource.data.status == 'approved') || isAdmin();
      // Public write path: create pending submissions only with strict shape validation.
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly([
          'status',
          'isFeatured',
          'source',
          'reviewerType',
          'parentName',
          'childName',
          'childAge',
          'city',
          'reviewText',
          'rating',
          'consentToPublishName',
          'consentToPublishChildName',
          'courseTags',
          'pageTags',
          'classFormat',
          'attendedCourse',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'status',
          'isFeatured',
          'source',
          'reviewerType',
          'parentName',
          'rating',
          'consentToPublishName',
          'consentToPublishChildName',
          'courseTags',
          'pageTags',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.isFeatured == false
        && request.resource.data.source == 'public_form'
        && request.resource.data.reviewerType == 'parent'
        && request.resource.data.parentName is string
        && request.resource.data.parentName.size() >= 2
        && request.resource.data.parentName.size() <= 80
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.rating % 1 == 0
        && (!('reviewText' in request.resource.data) || (request.resource.data.reviewText is string && request.resource.data.reviewText.size() <= 2000))
        && request.resource.data.consentToPublishName == true
        && request.resource.data.consentToPublishChildName == false
        && request.resource.data.courseTags is list
        && request.resource.data.courseTags.size() <= 6
        && request.resource.data.courseTags.hasOnly(['phonics', 'grammar', 'speaking'])
        && request.resource.data.pageTags is list
        && request.resource.data.pageTags.size() <= 6
        && request.resource.data.pageTags.hasOnly(['home', 'why-tiny-steps', 'class-samples', 'courses'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!('childName' in request.resource.data) || (request.resource.data.childName is string && request.resource.data.childName.size() <= 80))
        && (!('childAge' in request.resource.data) || (request.resource.data.childAge is number && request.resource.data.childAge >= 2 && request.resource.data.childAge <= 18 && request.resource.data.childAge % 1 == 0))
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 80))
        && (!('classFormat' in request.resource.data) || request.resource.data.classFormat in ['1:1', 'small_group'])
        && (!('attendedCourse' in request.resource.data) || (request.resource.data.attendedCourse is string && request.resource.data.attendedCourse.size() <= 120))
      );
      allow update, delete: if isAdmin();
    }

    // ----------------------------
    // PARENT WORKSHEET LIBRARY
    // ----------------------------
    match /parentWorksheetLibrary/{worksheetId} {
      allow read: if isAdmin();
      allow read: if isParent()
        && (
          (
            ('targetCourseIds' in resource.data)
            && (resource.data.targetCourseIds is list)
            && (resource.data.targetCourseIds.size() > 0)
          )
          || (
            ('targetParentIds' in resource.data)
            && (resource.data.targetParentIds is list)
            && (
              request.auth.uid in resource.data.targetParentIds
              || 'all_parents' in resource.data.targetParentIds
            )
          )
        );
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // BILLING CHARGES COLLECTION
    // ----------------------------
    match /billingCharges/{chargeId} {
      allow read: if isAdmin()
        || (isParent() && resource.data.parentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // PAYMENTS COLLECTION
    // ----------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isParent() && resource.data.parentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ----------------------------
    // PARENT WALLETS (SERVER-WRITE ONLY)
    // ----------------------------
    match /parentWallets/{parentId} {
      allow read: if isAdmin()
        || (isParent() && request.auth.uid == parentId);
      // Direct client writes are blocked; Cloud Functions/Admin SDK only.
      allow create, update, delete: if false;

      match /transactions/{transactionId} {
        allow read: if isAdmin()
          || (isParent() && request.auth.uid == parentId);
        // Direct client writes are blocked; Cloud Functions/Admin SDK only.
        allow create, update, delete: if false;
      }
    }

    // ----------------------------
    // PARENT MONTHLY READ MODELS (projection docs)
    // ----------------------------
    match /parentMonthlyReadModels/{parentId}/months/{monthKey} {
      allow read: if isAdmin()
        || (isParent() && request.auth.uid == parentId);
      allow write: if isAdmin();
    }

    match /{path=**}/months/{monthKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----------------------------
    // PARENT PAYMENT BACKFILL RUNS (admin read only)
    // ----------------------------
    match /parentPaymentBackfillRuns/{runId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;

      match /parents/{parentId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    // ----------------------------
    // TEACHER PAYOUTS COLLECTION
    // ----------------------------
    match /teacherPayouts/{payoutId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ----------------------------
    // TEACHER EARNINGS (event docs)
    // ----------------------------
    match /teacherEarnings/{earningId} {
      allow read: if isAdmin()
        || (
          isTeacher()
          && resource != null
          && ('teacherId' in resource.data)
          && resource.data.teacherId == request.auth.uid
        );
      allow write: if false;
    }

    // ----------------------------
    // PAYMENT CONFIRMATIONS
    // ----------------------------
    match /paymentConfirmations/{docId} {
      allow create: if isParent() && request.resource.data.parentUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------
    // MESSAGES COLLECTION
    // ----------------------------
    match /messages/{messageId} {
      allow read, create, update, delete: if isAdmin();

      allow read: if isTeacher()
        && ('participants' in resource.data)
        && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && ('fromId' in request.resource.data)
        && request.auth.uid == request.resource.data.fromId;

      allow update, delete: if false;
    }

    // ----------------------------
    // MESSAGE THREADS (SERVER-WRITE ONLY)
    // ----------------------------
    match /messageThreads/{threadId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && ('participantIds' in resource.data)
          && (request.auth.uid in resource.data.participantIds)
        );

      // Direct client writes are blocked; Cloud Functions/Admin SDK only.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() || isMessageThreadParticipant(threadId);

        // Direct client writes are blocked; callable function only.
        allow create, update, delete: if false;
      }
    }

    // ----------------------------
    // ADMIN STATS (ROLLUPS)
    // ----------------------------
    match /adminStats/{docId} {
      allow read: if isAdmin();
      allow write: if false;

      match /{document=**} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ----------------------------
    // PROGRESS COLLECTION
    // ----------------------------
    match /progress/{progressId} {
      allow read: if isAdmin();

      allow read: if isTeacher()
        && (
          (('teacherId' in resource.data) && resource.data.teacherId == request.auth.uid)
          || (('studentId' in resource.data) && resource.data.studentId is string && isTeacherOfKid(resource.data.studentId))
          || (('kidId' in resource.data) && resource.data.kidId is string && isTeacherOfKid(resource.data.kidId))
        );

      allow read: if isParent()
        && (
          (('parentId' in resource.data) && resource.data.parentId == request.auth.uid)
          || (('studentId' in resource.data) && resource.data.studentId is string && isParentOfKid(resource.data.studentId))
          || (('kidId' in resource.data) && resource.data.kidId is string && isParentOfKid(resource.data.kidId))
        );

      allow read: if isLP()
        && (
          (('lpId' in resource.data) && resource.data.lpId == request.auth.uid)
          || (
            ('studentId' in resource.data)
            && resource.data.studentId is string
            && kidExists(resource.data.studentId)
            && ('assignedLPs' in kidDoc(resource.data.studentId))
            && (request.auth.uid in kidDoc(resource.data.studentId).assignedLPs)
          )
          || (
            ('kidId' in resource.data)
            && resource.data.kidId is string
            && kidExists(resource.data.kidId)
            && ('assignedLPs' in kidDoc(resource.data.kidId))
            && (request.auth.uid in kidDoc(resource.data.kidId).assignedLPs)
          )
        );

      allow write: if isAdmin();
    }

    // ----------------------------
    // INVOICES COLLECTION
    // ----------------------------
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow read: if isLP() && resource.data.lpId == request.auth.uid;
    }

    // ----------------------------
    // COURSES COLLECTION
    // ----------------------------
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // LESSON LIBRARY
    // ----------------------------
    match /lessonFolders/{folderId} {
      allow read: if isTeacherOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /lessonCatalog/{lessonId} {
      allow read: if isTeacherOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /lessonAccessSessions/{accessId} {
      allow read: if isAdmin()
        || (
          isTeacher()
          && resource.data.teacherUid == request.auth.uid
          && resource.data.status == 'active'
          && resource.data.expiresAt is timestamp
          && request.time < resource.data.expiresAt
        );
      allow create, update, delete: if false;
    }

    match /lessonDailyAudit/{auditId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /teacherDailyAccess/{dailyId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ----------------------------
    // DEMO SESSIONS
    // ----------------------------
    match /leads/{leadId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly([
          'parentName',
          'whatsappNumber',
          'primaryPhone',
          'phoneNormalized',
          'childName',
          'childAge',
          'interestTrack',
          'programInterest',
          'source',
          'sourceDetail',
          'initialMessageSnippet',
          'mainConcern',
          'urgency',
          'timezone',
          'sourcePath',
          'attribution',
          'requestedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'parentName',
          'whatsappNumber',
          'primaryPhone',
          'phoneNormalized',
          'childName',
          'childAge',
          'programInterest',
          'source',
          'sourceDetail',
          'mainConcern',
          'sourcePath',
          'attribution',
          'requestedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.parentName is string
        && request.resource.data.parentName.size() >= 2
        && request.resource.data.parentName.size() <= 80
        && request.resource.data.whatsappNumber is string
        && request.resource.data.whatsappNumber.size() >= 8
        && request.resource.data.whatsappNumber.size() <= 24
        && request.resource.data.primaryPhone is string
        && request.resource.data.primaryPhone.size() >= 8
        && request.resource.data.primaryPhone.size() <= 24
        && request.resource.data.primaryPhone == request.resource.data.whatsappNumber
        && request.resource.data.phoneNormalized is string
        && request.resource.data.phoneNormalized.size() >= 8
        && request.resource.data.phoneNormalized.size() <= 24
        && request.resource.data.childName is string
        && request.resource.data.childName.size() >= 1
        && request.resource.data.childName.size() <= 80
        && request.resource.data.childAge is number
        && request.resource.data.childAge >= 3
        && request.resource.data.childAge <= 12
        && request.resource.data.childAge % 1 == 0
        && (
          !('interestTrack' in request.resource.data)
          || request.resource.data.interestTrack == null
          || request.resource.data.interestTrack in ['phonics', 'grammar', 'public_speaking']
        )
        && request.resource.data.programInterest in ['Phonics', 'Reading', 'Grammar', 'Speaking']
        && request.resource.data.source == 'website'
        && request.resource.data.sourceDetail is string
        && request.resource.data.sourceDetail.size() >= 1
        && request.resource.data.sourceDetail.size() <= 120
        && (
          !('initialMessageSnippet' in request.resource.data)
          || request.resource.data.initialMessageSnippet == null
          || (request.resource.data.initialMessageSnippet is string && request.resource.data.initialMessageSnippet.size() <= 1000)
        )
        && request.resource.data.mainConcern in [
          'Knows ABC but cannot read words',
          'Struggles with blending',
          'Reads slowly',
          'Makes grammar mistakes',
          'Gives one-word answers',
          'Hesitates to speak English',
          'Needs public speaking confidence',
          'Not sure where to start'
        ]
        && (
          !('urgency' in request.resource.data)
          || request.resource.data.urgency == null
          || request.resource.data.urgency in ['Today', 'This week', 'This month', 'Just exploring']
        )
        && (
          !('timezone' in request.resource.data)
          || request.resource.data.timezone == null
          || (request.resource.data.timezone is string && request.resource.data.timezone.size() <= 80)
        )
        && request.resource.data.sourcePath is string
        && request.resource.data.sourcePath.size() >= 1
        && request.resource.data.sourcePath.size() <= 200
        && request.resource.data.attribution is map
        && request.resource.data.attribution.keys().hasOnly([
          'utm_source',
          'utm_medium',
          'utm_campaign',
          'utm_content',
          'utm_term'
        ])
        && (
          !('utm_source' in request.resource.data.attribution)
          || request.resource.data.attribution.utm_source == null
          || (request.resource.data.attribution.utm_source is string && request.resource.data.attribution.utm_source.size() <= 120)
        )
        && (
          !('utm_medium' in request.resource.data.attribution)
          || request.resource.data.attribution.utm_medium == null
          || (request.resource.data.attribution.utm_medium is string && request.resource.data.attribution.utm_medium.size() <= 120)
        )
        && (
          !('utm_campaign' in request.resource.data.attribution)
          || request.resource.data.attribution.utm_campaign == null
          || (request.resource.data.attribution.utm_campaign is string && request.resource.data.attribution.utm_campaign.size() <= 160)
        )
        && (
          !('utm_content' in request.resource.data.attribution)
          || request.resource.data.attribution.utm_content == null
          || (request.resource.data.attribution.utm_content is string && request.resource.data.attribution.utm_content.size() <= 160)
        )
        && (
          !('utm_term' in request.resource.data.attribution)
          || request.resource.data.attribution.utm_term == null
          || (request.resource.data.attribution.utm_term is string && request.resource.data.attribution.utm_term.size() <= 160)
        )
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
      );
    }

    match /leads/{leadId}/communications/{communicationId} {
      allow read, write: if isAdmin();
    }

    match /whatsappInboundUnmatched/{docId} {
      allow read, write: if isAdmin();
    }

    match /demoSessions/{demoId} {
      allow read: if isAdmin()
        || (
          isTeacher()
          && (
            resource.data.status == 'open'
            || (
              ('assignedTeacherId' in resource.data)
              && resource.data.assignedTeacherId == request.auth.uid
            )
          )
        );
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // Sensitive admin-only companion docs (e.g. parent phone)
    match /demoSessionsPrivate/{demoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-only dedupe index for child + parent phone combinations
    match /demoSessionUniqueKeys/{keyId} {
      allow read, write: if false;
    }

    // ----------------------------
    // LESSON VIEW AUDIT
    // ----------------------------
    match /lesson_view_audit/{sessionId} {
      allow read: if isAdmin();

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ----------------------------
    // NOTIFICATIONS
    // ----------------------------
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // ----------------------------
    // NOTIFICATION TOKENS
    // ----------------------------
    match /notificationTokens/{tokenId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /bulkUploadJobs/{jobId} {
      allow create, read, update, delete: if isAdmin();
    }

    match /ai-usage-logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /ai-error-logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /debug/{doc=**} {
      allow read, write: if isAdmin();
    }

    // ----------------------------
    // CONFIG COLLECTION
    // ----------------------------
    // config/gamesCatalog: readable by authenticated users (especially parents for dashboard)
    match /config/gamesCatalog {
      allow read: if isSignedIn();
      allow write: if false; // only server-side/admin SDK should write
    }

    match /config/picklists {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /config/curriculumTopics {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /config/payments {
      allow read: if isAdmin() || isParent();
      allow write: if isAdmin();
    }

    match /config/insights {
      allow read: if isAdmin();
      allow write: if false; // only callable (admin SDK) should write
    }
  }
}
