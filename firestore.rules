rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------
    // Helper functions
    // ----------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDocExists(uid) {
      return exists(userDocPath(uid));
    }

    // Safe role getter (only call after exists)
    function userRole(uid) {
      return get(userDocPath(uid)).data.role.lower();
    }

    // Admin check:
    // - seeded UID (dev convenience)
    // - OR custom claim role == 'admin'
    // - OR Firestore users/{uid}.role == 'admin'
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'cwEYiYRydtOeeNRoCO0j3VSI2vE3' ||
        (request.auth.token != null
          && ('role' in request.auth.token)
          && request.auth.token.role.lower() == 'admin') ||
        (userDocExists(request.auth.uid) && userRole(request.auth.uid) == 'admin')
      );
    }

    function isTeacher() {
      return isSignedIn()
        && userDocExists(request.auth.uid)
        && userRole(request.auth.uid) == 'teacher';
    }

    function isParent() {
      return isSignedIn()
        && userDocExists(request.auth.uid)
        && userRole(request.auth.uid) == 'parent';
    }

    function isLP() {
      return isSignedIn()
        && userDocExists(request.auth.uid)
        && (
          userRole(request.auth.uid) == 'learningpartner' ||
          userRole(request.auth.uid) == 'learning-partner'
        );
    }

    function isKid() {
      return isSignedIn()
        && userDocExists(request.auth.uid)
        && userRole(request.auth.uid) == 'kid';
    }

    function touchesAssignmentFields() {
      return
        ('assignedLPs' in request.resource.data) ||
        ('assignedParents' in request.resource.data) ||
        ('assignedTeachers' in request.resource.data);
    }

    function touchesRoleField() {
      return ('role' in request.resource.data) && (request.resource.data.role != resource.data.role);
    }

    // ----------------------------
    // Kid access helpers (NO "let")
    // ----------------------------
    function kidPath(kidId) {
      return /databases/$(database)/documents/kids/$(kidId);
    }

    function kidData(kidId) {
      return get(kidPath(kidId)).data;
    }

    // IMPORTANT: This does NOT depend on users/{uid}.role existing.
    // It purely checks the kids/{kidId} document fields.
    function canAccessKid(kidId) {
      return isSignedIn()
        && exists(kidPath(kidId))
        && (
          isAdmin() ||

          // parent-style linkage
          (('primaryParentId' in kidData(kidId)) && kidData(kidId).primaryParentId == request.auth.uid) ||
          (('parentIds' in kidData(kidId)) && (request.auth.uid in kidData(kidId).parentIds)) ||
          (('assignedParents' in kidData(kidId)) && (request.auth.uid in kidData(kidId).assignedParents)) ||

          // teacher-style linkage
          (('teacherId' in kidData(kidId)) && kidData(kidId).teacherId == request.auth.uid) ||
          (('assignedTeachers' in kidData(kidId)) && (request.auth.uid in kidData(kidId).assignedTeachers)) ||

          // learning partner linkage
          (('assignedLPs' in kidData(kidId)) && (request.auth.uid in kidData(kidId).assignedLPs))
        );
    }

    // ----------------------------
    // Public game reference data
    // ----------------------------
    match /gameData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------
    // USERS COLLECTION
    // ----------------------------
    match /users/{uid} {
      allow read: if isSignedIn();

      // Admin only
      allow create, delete: if isAdmin();

      // Update:
      // - Admin can update anything
      // - User can update own profile except role + assignment fields
      allow update: if isAdmin()
        || (
          request.auth.uid == uid
          && !touchesAssignmentFields()
          && !touchesRoleField()
        );
    }

    match /users/{userId}/progress/{document=**} {
      allow read, write, create: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/gameStats/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ----------------------------
    // LEADERBOARDS
    // ----------------------------
    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /teachers/{teacherId}/classes/{classId}/studentMetrics/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == teacherId;
    }

    // ----------------------------
    // KIDS COLLECTION
    // ----------------------------
    match /kids/{kidId} {
      // Admin full access
      allow read, create, update, delete: if isAdmin();

      // Others: read only if linked to kid
      allow read: if canAccessKid(kidId);

      // Non-admins don't write kid doc directly
      allow create, update, delete: if false;

      // ✅ Game sessions under the kid
      match /gameSessions/{sessionId} {
        allow read: if canAccessKid(kidId);

        // Create: allow if user can access kid
        // and minimum required fields exist.
        allow create: if canAccessKid(kidId)
          && ('gameId' in request.resource.data)
          && ('createdAt' in request.resource.data)
          && (
            !('createdByUid' in request.resource.data) ||
            request.resource.data.createdByUid == request.auth.uid ||
            request.resource.data.createdByUid == null
          );

        // keep sessions immutable (audit trail)
        allow update, delete: if isAdmin();
      }
    }

    // ----------------------------
    // ENROLLMENTS
    // ----------------------------
    match /enrollments/{enrollmentId} {
      allow read, write: if isAdmin();
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow read: if isLP() && resource.data.lpId == request.auth.uid;
    }

    // ----------------------------
    // SESSIONS
    // ----------------------------
    match /sessions/{sessionId} {
      allow read, write: if isAdmin();
      allow read, write: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow read: if isParent() && resource.data.parentId == request.auth.uid;

      allow read: if isKid()
        && ('kidIds' in resource.data)
        && (request.auth.uid in resource.data.kidIds);
    }

    // ----------------------------
    // MESSAGES
    // ----------------------------
    match /messages/{messageId} {
      allow read, create, update, delete: if isAdmin();

      allow read: if isTeacher()
        && ('participants' in resource.data)
        && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && ('fromId' in request.resource.data)
        && request.auth.uid == request.resource.data.fromId;

      allow update, delete: if false;
    }

    // ----------------------------
    // PROGRESS
    // ----------------------------
    match /progress/{progressId} {
      allow read, write: if isAdmin();
      allow read: if isTeacher() || isParent() || isLP();
      allow write: if false;
    }

    // ----------------------------
    // INVOICES
    // ----------------------------
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
      allow read: if isParent() && resource.data.parentId == request.auth.uid;
      allow read: if isLP() && resource.data.lpId == request.auth.uid;
    }

    // ----------------------------
    // COURSES
    // ----------------------------
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // LESSON LIBRARY
    // ----------------------------
    match /lessonFolders/{folderId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------
    // LESSON VIEW AUDIT
    // ----------------------------
    match /lesson_view_audit/{sessionId} {
      allow read: if isAdmin();

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ----------------------------
    // NOTIFICATIONS / ADMIN / DEBUG
    // ----------------------------
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /bulkUploadJobs/{jobId} {
      allow create, read, update, delete: if isAdmin();
    }

    match /ai-usage-logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /ai-error-logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /adminStats/{document=**} {
      allow read, write: if isAdmin();
    }

    match /debug/{doc=**} {
      allow read, write: if isSignedIn();
    }
  }
}
