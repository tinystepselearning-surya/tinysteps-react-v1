{
  "name": "functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "set-groq-secret": "node scripts/setGroqSecret.js",
    "set-groq-secret-shell": "sh scripts/set-groq-secret.sh",
    "lint": "eslint \"src/**/*.{ts,js}\" \"scripts/**/*.{ts,js}\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "echo \"No tests configured for Cloud Functions\"",
    "test:run": "npm run test"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.1",
    "aframe": "^1.7.1",
    "axios": "^1.7.8",
    "cors": "^2.8.5",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "groq-sdk": "^0.36.0",
    "nice-color-palettes": "^4.0.0",
    "papaparse": "^5.5.0",
    "three-bmfont-text": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.26.0",
    "firebase-functions-test": "^3.4.1",
    "globals": "^16.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.49.0"
  },
  "overrides": {
    "got": "^11.8.5"
  },
  "directories": {
    "lib": "lib"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
