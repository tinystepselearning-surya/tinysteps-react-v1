    "rewrites": [
      {
        "source": "/api/contact",
        "function": {
          "functionId": "contactForm",
          "region": "asia-south1"
        }
      },
      {
        "source": "/blog/**",
        "function": {
          "functionId": "notFoundRoute",
          "region": "asia-south1"
        }
      },
      {
        "source": "/courses/**",
        "function": {
          "functionId": "notFoundRoute",
          "region": "asia-south1"
        }
      },
      {
        "source": "/main/**",
        "function": {
          "functionId": "notFoundRoute",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
