{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@components/*": ["src/components/*"],
      "@/hooks/*": ["src/hooks/*"]
    },
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": [
    "src",
    "src/tests/**/*.ts",
    "src/tests/**/*.tsx",
    "src/tests/**/*.js",
    "src/tests/**/*.jsx",
    "src/tests/hooks/useEnrollments.spec.tsx",
    "src/types"
  ],
  "exclude": [
    "node_modules",
    "src/pages/admin/beta-analytics.jsx"
  ]
}