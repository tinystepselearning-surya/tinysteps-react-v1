{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@components/*": ["src/components/*"]
    }
  },
  "include": [
    "src",
    "src/tests/**/*.ts",
    "src/tests/**/*.tsx",
    "src/tests/**/*.js",
    "src/tests/**/*.jsx",
    "src/tests/hooks/useEnrollments.spec.tsx"
  ],
  "exclude": ["node_modules"]
}