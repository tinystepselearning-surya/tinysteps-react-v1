# =========================
# Tiny Steps - Root Ignore
# =========================

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Dependencies
**/node_modules/

# Build output
dist/
build/
coverage/
.cache/
.sass-cache/
.parcel-cache/
.serverless/
.turbo/
*.tsbuildinfo

# Firebase / emulators / debug
.firebase/
firebase-debug.log
firestore-debug.log
emu*.log
*.log

# Local env (never commit)
.env
.env.*
*.local

# Archives / bundles
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Firebase Admin SDK keys (NEVER COMMIT)
*firebase-adminsdk*.json
serviceAccount*.json
tinysteps-react-v1-firebase-adminsdk-*.json

# Prevent compiled JS files from shadowing TS/TSX sources in src/
src/**/*.js
src/**/*.jsx
!src/lib/routeSeoRegistry.js
!src/lib/publicCoursePages.js
!src/components/components/LiquidEther.jsx
!src/**/*.config.js
*.js.backup
*.jsx.backup

# Backup files
*.backup
*.ts.backup
*.tsx.backup

# Optional: large local dirs you don't want tracked (keep if used)
logs/
reports/
private/

# If you keep generated assets out of git
public/assets/
dist/assets/

# Firebase Data Connect local data
/dataconnect/.dataconnect/
**/.dataconnect/

# Playwright auth + reports
.auth/
playwright-report/
test-results/
