# Prevent compiled JS files from shadowing TS/TSX sources
# Only ignore in src/, allow .js in root (config files like vite.config.js)
src/**/*.js
src/**/*.jsx
!src/**/*.config.js
*.js.backup
*.jsx.backup

# Firebase Admin SDK keys (NEVER COMMIT)
*firebase-adminsdk*.json
serviceAccount*.json
